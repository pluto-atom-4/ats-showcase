{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_PAT}"
      }
    },
    "code-review-graph": {
      "type": "stdio",
      "command": "code-review-graph",
      "args": ["serve"]
    },
    "graphify": {
      "type": "stdio",
      "command": "graphify-mcp",
      "args": ["graphify-out/graph.json"]
    }
  }
}
