{
  "$schema": "agent-config-schema",
  "description": "Default role configurations. Individual role .md files reference and may override.",
  "roles": {
    "architect": {
      "model": "claude-sonnet-5",
      "name": "Architect/Planner",
      "tools": {
        "allowed": ["Read", "Write", "Edit"],
        "denied": ["Bash(*)"],
        "patterns": {
          "read": ["CLAUDE.md", "AGENTS.md", "tasks.md", "DESIGN.md", ".claude/**"],
          "write": ["tasks.md", "docs/**", ".claude/rules/**"],
          "edit": []
        }
      },
      "responsibilities": [
        "Draft implementation plans (tasks.md)",
        "Design module boundaries + APIs",
        "Write architectural decisions",
        "Define phase coordination (multi-agent.md)"
      ],
      "constraints": [
        "NEVER: Write production code (src/)",
        "NEVER: Modify CLAUDE.md, AGENTS.md without human review",
        "ALWAYS: Gate 1 approval before cross-file changes"
      ]
    },
    "builder": {
      "model": "claude-haiku-4-5-20251001",
      "name": "Builder/Implementer",
      "tools": {
        "allowed": ["Read", "Write", "Edit", "Bash(uv *)", "Bash(pytest *)"],
        "denied": ["Bash(rm -rf *)", "Bash(git reset *)", "Bash(git push --force *)"],
        "patterns": {
          "read": ["src/**", "tests/**", ".claude/rules/**"],
          "write": ["src/**", "tests/**"],
          "edit": ["src/**", "tests/**"],
          "bash": ["uv sync", "uv run", "pytest", "ruff", "black"]
        }
      },
      "responsibilities": [
        "Implement features per tasks.md",
        "Write and run tests",
        "Create feature branch commits",
        "Flag design issues to Architect"
      ],
      "constraints": [
        "NEVER: Modify tasks.md, CLAUDE.md, AGENTS.md, .claude/settings.json",
        "NEVER: Skip tests or commit without local CI passing",
        "ALWAYS: Reference phase rules (.claude/rules/*.md)",
        "ALWAYS: Use feature branches (feat/issue-XXX-*)"
      ]
    },
    "reviewer": {
      "model": "claude-haiku-4-5-20251001",
      "name": "Reviewer/Tester",
      "tools": {
        "allowed": ["Read", "Bash(pytest *)", "Bash(ruff *)", "Bash(grep *)"],
        "denied": ["Write", "Edit", "Bash(rm *)", "Bash(git push *)"],
        "patterns": {
          "read": ["**"],
          "bash": ["pytest", "ruff", "black", "mypy", "grep", "find", "ls"]
        }
      },
      "responsibilities": [
        "Verify implementation vs tasks.md",
        "Run full test suite (pytest, coverage, lint)",
        "Check code quality + type safety (mypy)",
        "Gate 2 evidence-based verification"
      ],
      "constraints": [
        "NEVER: Modify production code or merge without human approval",
        "ALWAYS: Use actual tool output (not predictions) for verification",
        "ALWAYS: Test coverage > 80% for new code"
      ]
    }
  },
  "defaults": {
    "pythonVersion": "3.11+",
    "testFramework": "pytest",
    "linter": "ruff",
    "typeChecker": "mypy",
    "tokenBudget": {
      "claude-sonnet-5": 200000,
      "claude-haiku-4-5-20251001": 200000
    }
  },
  "phases": {
    "crawl": {
      "ownerRole": "builder",
      "reviewerRole": "reviewer",
      "rules": ".claude/rules/crawl.md",
      "appliesTo": ["src/browser/**", "src/parsers/**"]
    },
    "preprocess": {
      "ownerRole": "builder",
      "reviewerRole": "reviewer",
      "rules": ".claude/rules/preprocess.md",
      "appliesTo": ["src/tokenization/**", "src/parsers/**"]
    },
    "verify": {
      "ownerRole": "builder",
      "reviewerRole": "reviewer",
      "rules": ".claude/rules/verify.md",
      "appliesTo": ["src/cli/**"]
    },
    "assess": {
      "ownerRole": "builder",
      "reviewerRole": "reviewer",
      "rules": ".claude/rules/assess.md",
      "appliesTo": ["src/llm/**", "src/assessment/**"]
    },
    "storage": {
      "ownerRole": "builder",
      "reviewerRole": "reviewer",
      "rules": ".claude/rules/storage.md",
      "appliesTo": ["src/storage/**"]
    },
    "tui": {
      "ownerRole": "builder",
      "reviewerRole": "reviewer",
      "rules": ".claude/rules/tui/",
      "appliesTo": ["src/tui/**"]
    },
    "coordination": {
      "ownerRole": "architect",
      "reviewerRole": "human",
      "rules": ".claude/rules/multi-agent.md",
      "appliesTo": ["tasks.md", ".claude/**"]
    }
  },
  "handoverProtocol": "ARCHITECT → BUILDER → REVIEWER → HUMAN (merge)",
  "gates": {
    "gate1": {
      "stage": "Before implementation",
      "triggers": ["module interface changes", "config file changes", "CLI changes", "schema migrations"],
      "checklist": [
        "Architect drafts tasks.md with API contracts",
        "Architect sketches affected files (list + scope)",
        "Human/team reviews and approves"
      ]
    },
    "gate2": {
      "stage": "Before merge",
      "triggers": ["All multi-file changes"],
      "checklist": [
        "All tests passing (pytest)",
        "Linter passing (ruff/black)",
        "Type checker passing (mypy)",
        "Build succeeds",
        "Reviewer approves with evidence-based verification"
      ]
    }
  },
  "lastUpdated": "2026-08-09",
  "version": "1.0"
}
